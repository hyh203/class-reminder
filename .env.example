# ============================================
# 课程提醒配置模板
# 复制此文件为 .env，填入你自己的配置
# ============================================

# 企业微信机器人 Webhook
# 获取方式：群聊 → 右上角··· → 群机器人 → 添加 → 复制 Webhook 地址
WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=YOUR_KEY_HERE

# 飞书机器人 Webhook  
# 获取方式：群聊 → 设置 → 群机器人 → 添加机器人 → 自定义机器人 → 复制 Webhook 地址
# 注意：飞书机器人需要设置"自定义关键词"，建议填"提醒"
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/YOUR_KEY_HERE

# Google Calendar 凭据（JSON 格式，整行粘贴）
# 获取方式：
# 1. 打开 https://console.cloud.google.com/
# 2. 创建项目 → 启用 Google Calendar API
# 3. 凭据 → 创建凭据 → OAuth 客户端 ID → 桌面应用
# 4. 下载 JSON 文件，打开复制全部内容，粘贴到下面（去掉换行，变成一行）
GOOGLE_CREDENTIALS={"installed":{"client_id":"YOUR_CLIENT_ID","project_id":"YOUR_PROJECT","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_secret":"YOUR_SECRET","redirect_uris":["http://localhost"]}}
